PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
# Global request quota: 5 requests per IP every 60 seconds.
THROTTLE_LIMIT=5
THROTTLE_TTL_MS=60000
# Guest users can create one trial itinerary per IP during this period.
GUEST_ITINERARY_TTL_MS=86400000
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Create a Web OAuth client in Google Cloud. The callback URL must match exactly.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Generate a long random value, for example: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret
# Firebase / Cloud Firestore. Never commit the service-account JSON file.
FIREBASE_PROJECT_ID=your_firebase_project_id
# Local: path outside this repository to the Firebase service account JSON file.
# On Cloud Run/App Hosting, remove this and use the workload's Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
